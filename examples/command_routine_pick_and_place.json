  "command_routines": [
    {
      "command_routine": "pick-and-place-demo",
      "dataset": "ur10e-pick-and-place-demo",
      "name": "Pick and Place Demo",
      "description": "A pick-and-place cycle mixing joint, Cartesian PTP, linear and circular motions with varying velocities and blending settings. Cartesian targets are dataset poses resolved relative to the 'pick-place-station' coordinate system.",
      "commands": [
        {
          "type": "motion_command",
          "target": {
            "type": "joint_position",
            "joints": [
              0,
              -1.57,
              -1.57,
              0,
              1.57,
              0
            ]
          },
          "path_type": {
            "path_definition_name": "PathJointPTP"
          },
          "intent": "Move to a safe joint retract position"
        },
        {
          "type": "motion_command",
          "target": {
            "type": "local_pose",
            "pose_id": "ready"
          },
          "path_type": {
            "path_definition_name": "PathCartesianPTP"
          },
          "intent": "Move to the ready pose"
        },
        {
          "type": "motion_command",
          "target": {
            "type": "local_pose",
            "pose_id": "approach-pick"
          },
          "path_type": {
            "path_definition_name": "PathCartesianPTP"
          },
          "motion_settings": {
            "blending": {
              "min_velocity_in_percent": 50,
              "blending_name": "BlendingAuto",
              "type": "blending_auto"
            },
            "limits_override": {
              "tcp_velocity_limit": 250
            }
          },
          "intent": "Approach the pick location"
        },
        {
          "type": "motion_command",
          "target": {
            "type": "local_pose",
            "pose_id": "pick"
          },
          "path_type": {
            "path_definition_name": "PathLine"
          },
          "motion_settings": {
            "blending": {
              "position_zone_radius": 5,
              "blending_name": "BlendingPosition",
              "type": "blending_position"
            },
            "limits_override": {
              "tcp_velocity_limit": 60
            }
          },
          "intent": "Descend in a straight line to the pick pose"
        },
        {
          "type": "set_io",
          "io_value": {
            "io": "digital_out[0]",
            "value": true,
            "value_type": "boolean"
          },
          "io_origin": "CONTROLLER",
          "intent": "Close the gripper"
        },
        {
          "type": "wait_for_time",
          "duration_ms": 300,
          "intent": "Let the gripper close"
        },
        {
          "type": "motion_command",
          "target": {
            "type": "local_pose",
            "pose_id": "approach-pick"
          },
          "path_type": {
            "path_definition_name": "PathLine"
          },
          "motion_settings": {
            "blending": {
              "position_zone_radius": 5,
              "blending_name": "BlendingPosition",
              "type": "blending_position"
            },
            "limits_override": {
              "tcp_velocity_limit": 60
            }
          },
          "intent": "Retract in a straight line from the pick pose"
        },
        {
          "type": "motion_command",
          "target": {
            "type": "local_pose",
            "pose_id": "place"
          },
          "path_type": {
            "path_definition_name": "PathCircle",
            "via_pose": {
              "type": "local_pose",
              "pose_id": "via-sweep"
            }
          },
          "motion_settings": {
            "limits_override": {
              "tcp_velocity_limit": 150
            }
          },
          "intent": "Sweep to the place location on a circular path"
        },
        {
          "type": "set_io",
          "io_value": {
            "io": "digital_out[0]",
            "value": false,
            "value_type": "boolean"
          },
          "io_origin": "CONTROLLER",
          "intent": "Open the gripper"
        },
        {
          "type": "wait_for_time",
          "duration_ms": 300,
          "intent": "Let the gripper open"
        },
        {
          "type": "motion_command",
          "target": {
            "type": "local_pose",
            "pose_id": "ready"
          },
          "path_type": {
            "path_definition_name": "PathCartesianPTP"
          },
          "intent": "Return to the ready pose"
        }
      ],
      "metadata": {
        "example": "command_routine_plan_and_execute"
      },
      "motion_group_setup": null
    }
  ]
