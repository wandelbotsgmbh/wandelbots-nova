---
extends: default

ignore: |
  coverage
  node_modules
  dist
  build
  .git
  uv.lock
  # LEAPP policy exports: generated by the exporter, not hand-written
  novapolicy/examples/execute_leapp_two_point_reach/exported/
  novapolicy/tests/unit/data/leapp_reach/

rules:
  line-length:
    level: warning
    max: 100

  brackets:
    max-spaces-inside: 1
    level: error

  quoted-strings:
    quote-type: any
    required: false
    level: warning

  trailing-spaces:
    level: error
...
